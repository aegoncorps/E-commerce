# Ambiente do front Aegon Store
# Copie para .env.local para desenvolvimento no seu computador.

# development: execução local | preview: deploy de pull request | production: main
VITE_APP_ENV=development

# Opcional. Mantenha vazio enquanto a loja operar somente com dados locais.
# Quando uma API for conectada, configure a mesma variável na Vercel para
# Preview e Production — nunca versionar tokens ou chaves aqui.
VITE_API_URL=
